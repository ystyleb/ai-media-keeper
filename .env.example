# 复制为 .env 后按实际填写，或直接 export 这些环境变量后启动 app.py

# === NAS SSH 连接 ===
# 你的 NAS 内网 IP 和 SSH 端口
NAS_HOST=192.168.1.100
NAS_PORT=22
NAS_USER=admin

# 受控目录（所有文件操作都被限制在这个目录下）
# QNAP 默认是 /share/CACHEDEV1_DATA 或 /share/CACHEDEV2_DATA
# 群晖一般是 /volume1
NAS_BASE_PATH=/share/CACHEDEV1_DATA

# === API Token（推荐固定，否则每次重启会随机生成） ===
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
NAS_API_TOKEN=replace_with_long_random_hex_string

# === qBittorrent 配置 ===
# url / user 也会写进 config/qbit.json（UI 里也能改）
QBIT_URL=http://192.168.1.100:8080
QBIT_USER=admin

# 【密码安全策略】密码永远不落盘到 config/qbit.json
# 想要跨重启持久化，唯一办法是设这个 env var
# 不设的话每次 Flask 重启都要去 UI 重新输入一次密码
QBIT_PASS=

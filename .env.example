# 所有 env 都是 **可选** 的——首次启动会自动初始化所需配置。
# 此文件只用于 CI / 多机部署 / 高级覆盖场景。
#
# 零配置启动：直接 `python3 app.py`
# → 第一次会自动在 config/ 目录生成 .api_token + .signing_key（chmod 600）
# → 启动日志打印一次 API token，复制到浏览器即可
# → NAS / qBit 配置都在 UI 的"设置"页填
#
# 下面是 override 选项：

# === NAS SSH 连接（可选，UI 也能配） ===
# NAS_HOST=192.168.1.100
# NAS_PORT=22
# NAS_USER=admin
# NAS_BASE_PATH=/share/CACHEDEV1_DATA   # QNAP / Synology 默认值不同

# === API Token（可选，未设则自动生成到 config/.api_token） ===
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
# NAS_API_TOKEN=

# === Destructive Action 签名 secret（可选，未设则自动生成到 config/.signing_key） ===
# 多 worker / gunicorn 部署需要显式设此 env（自动生成只覆盖单 worker / dev）
# 生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"
# NAS_ACTION_SIGNING_KEY=

# === qBittorrent 配置（可选，UI 也能配） ===
# QBIT_URL=http://192.168.1.100:8080
# QBIT_USER=admin
# QBIT_PASS=     # 密码永不落盘，仅 UI 输入或此 env 跨重启持久化
